# Copy this file to .env and fill in your credentials
# Never commit .env — it is gitignored

# Obligatoires — l'app refuse de démarrer sans (erreur explicite au chargement).
# Sur Vercel : les définir sur Production ET Preview, puis REDÉPLOYER — les
# variables VITE_* sont injectées au build, un redémarrage ne suffit pas.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Sentry — obtenez le DSN sur sentry.io (Project Settings → Client Keys)
# Laissez vide en dev local si vous ne voulez pas envoyer d'erreurs
VITE_SENTRY_DSN=
